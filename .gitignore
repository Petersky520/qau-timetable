# 对已安装的用户做覆盖升级 —— 所以永远不要提交。
qau-release.jks
*.jks
*.keystore
keystore.properties

# ---------------------------------------------------------------- 本机配置
# local.properties 里是本机 SDK 路径，别人的机器上必然不同
local.properties

